# Your game's Steam app ID: the number in its store link, store.steampowered.com/app/<ID>/
STEAM_APP_ID=
# Discord: channel settings > Integrations > Webhooks > New Webhook > Copy Webhook URL. Use a private channel.
DISCORD_WEBHOOK_URL=
# 0 = check once and exit (good for cron). 15 = keep running and check every 15 minutes.
CHECK_EVERY_MINUTES=15
# On the very first run, post this many of the newest reviews so you can see it works. Older reviews are never posted.
FIRST_RUN_POSTS=3
# Most reviews posted per check; the rest go out on the next check.
MAX_POSTS_PER_RUN=20
# Where it remembers which reviews it already posted.
STATE_FILE=review_pulse_state.json
